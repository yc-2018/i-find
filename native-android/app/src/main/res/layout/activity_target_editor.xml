<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/EditorLabel"
            android:text="@string/name" />

        <EditText
            android:id="@+id/nameInput"
            style="@style/EditorInput"
            android:hint="@string/name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <TextView
            style="@style/EditorLabel"
            android:text="@string/icon_source" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <RadioGroup
                android:id="@+id/iconSourceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/builtinIconRadio"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/icon_mode_builtin"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/installedAppIconRadio"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/icon_mode_installed_app"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/galleryIconRadio"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/icon_mode_gallery"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/generatedIconRadio"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/icon_mode_generated"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/remoteIconRadio"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/icon_mode_remote"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/border" />

            <LinearLayout
                android:id="@+id/iconPreviewButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="94dp"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingTop="10dp"
                android:paddingEnd="2dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/iconPreview"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="@string/icon_preview" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/iconActionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/iconActionSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/subtle_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iconActionArrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/subtle_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/remoteIconSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="@string/remote_icon_url"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/remoteIconInput"
                    style="@style/EditorInput"
                    android:background="@drawable/bg_surface_strong"
                    android:gravity="top|start"
                    android:hint="@string/remote_icon_url_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textMultiLine"
                    android:maxLines="6"
                    android:minLines="3"
                    android:scrollHorizontally="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/remote_icon_cache_summary"
                    android:textColor="@color/subtle_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/EditorLabel"
            android:text="@string/android_package" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="@string/android_package_summary"
            android:textColor="@color/subtle_text"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/packageInput"
            style="@style/EditorInput"
            android:hint="@string/android_package_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            style="@style/EditorLabel"
            android:text="@string/primary_template" />

        <EditText
            android:id="@+id/primaryInput"
            style="@style/EditorInput"
            android:gravity="top|start"
            android:hint="@string/primary_template_hint"
            android:importantForAutofill="no"
            android:inputType="textUri|textMultiLine"
            android:maxLines="6"
            android:minLines="3"
            android:scrollHorizontally="false" />

        <TextView
            style="@style/EditorLabel"
            android:text="@string/fallback_template" />

        <EditText
            android:id="@+id/fallbackInput"
            style="@style/EditorInput"
            android:gravity="top|start"
            android:hint="@string/fallback_template_hint"
            android:importantForAutofill="no"
            android:inputType="textUri|textMultiLine"
            android:maxLines="6"
            android:minLines="3"
            android:scrollHorizontally="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/keyword_placeholder_hint"
            android:textColor="@color/subtle_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_accent_button"
            android:backgroundTint="@null"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
